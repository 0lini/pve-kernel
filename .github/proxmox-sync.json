{
  "proxmox_remote": "upstream",
  "proxmox_url": "https://github.com/proxmox/pve-kernel.git",
  "proxmox_ref": "master",
  "patch_dir": "patches/kernel",
  "pin_file": ".github/upstream-pins.toml",
  "report_path": ".github/sync-report.md",
  "skip_patch_regexes": [
    "(?i)KVM-x86",
    "(?i)KVM-nVMX",
    "(?i)KVM-SVM",
    "(?i)KVM-nSVM",
    "(?i)KVM-TDX",
    "(?i)KVM-SEV",
    "(?i)KVM-VMX",
    "(?i)(^|[-_/])x86([-_/]|$)",
    "(?i)arch/x86",
    "(?i)Ubuntu-SAUCE.*[Ii]ntel",
    "(?i)iommu-intel",
    "(?i)iommu-amd",
    "(?i)amdgpu",
    "(?i)8250_mid",
    "(?i)Safe-RET",
    "(?i)crypto-ccp",
    "(?i)PKRU",
    "(?i)EPT_",
    "(?i)MBEC",
    "(?i)GMET",
    "(?i)SPTE_",
    "(?i)megaraid",
    "(?i)bnxt_en",
    "(?i)ixgbe",
    "(?i)(^|[-])ice-",
    "(?i)txgbe",
    "(?i)qede",
    "(?i)mlx5",
    "(?i)vmxnet3",
    "(?i)denverton",
    "(?i)[Hh]yper-?[Vv]",
    "rds-Fix-inet6_addr_lst-NULL-dereference",
    "sch_teql-Introduce-slaves_lock",
    "watchdog-fix-refcount-tracking-races",
    "posix-timers-Expand-timer_-re-arm",
    "apparmor-don-t-audit-files-pointing-to-aa_null",
    "apparmor-fix-shadowing-of-plabel",
    "raid5-use-stripe-state-snapshot",
    "md-replace-wait-loop-with-wait_event"
  ],
  "sync_files": [
    "debian/rules.d/config-common.opts",
    "debian/proxmox_prevent_autoload.conf",
    "debian/scripts/abi-check",
    "debian/scripts/abi-generate",
    "debian/scripts/export-patchqueue",
    "debian/scripts/find-firmware.pl",
    "debian/scripts/import-patchqueue",
    "debian/scripts/import-upstream-tag",
    "abi-blacklist"
  ],
  "zfs": {
    "submodule_path": "submodules/zfsonlinux",
    "github_url": "https://github.com/openzfs/zfs.git",
    "fallback_branch": "zfs-2.4-release"
  }
}
